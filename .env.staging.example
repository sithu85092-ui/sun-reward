# Copy to .env only inside an isolated staging workspace.
PORT=3000
DB_PATH=./data.staging.sqlite
BOT_TOKEN=STAGING_ONLY_TELEGRAM_BOT_TOKEN
BOT_USERNAME=STAGING_BOT_USERNAME
ADMIN_KEY=STAGING_ONLY_LONG_RANDOM_ADMIN_KEY
REQUIRED_CHANNEL=@staging_channel
POINTS_PER_REFERRAL=50
DAILY_CHECKIN_POINTS=5
MIN_WITHDRAWAL_POINTS=1000
SUN_USD_RATE=0.001
WITHDRAWAL_USD_PER_SUN=0.001
MMK_PER_USD=3500
MIN_WITHDRAWAL_MICRO=1000000000
MAX_WITHDRAWAL_MICRO=1000000000000
DAILY_WITHDRAWAL_MICRO=2000000000000
VIP_REQUIRED_FOR_WITHDRAWAL=0
TICKER_TEXT=STAGING ONLY — no production payouts
